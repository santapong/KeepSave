DATABASE_URL=postgres://keepsave:keepsave_dev@localhost:5432/keepsave?sslmode=disable
MASTER_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWtleS4u  # base64-encoded 32 bytes (dev only)
JWT_SECRET=dev-jwt-secret-change-me
PORT=8080
CORS_ORIGINS=*
# Comma-separated emails allowed to reach the cross-tenant /admin endpoints.
# Empty => /admin denies everyone (fail-closed).
KEEPSAVE_PLATFORM_ADMIN_EMAILS=admin@example.com
# Comma-separated reverse-proxy CIDRs whose X-Forwarded-For/X-Real-IP headers
# are trusted when deriving the client IP (rate-limit key + audit IP). Empty
# (default) => trust NO proxy, so a forged XFF header cannot spoof the client IP.
# Set to your ingress/LB CIDR when running behind a trusted proxy, e.g. 10.0.0.0/8
TRUSTED_PROXIES=
