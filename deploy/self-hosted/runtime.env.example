# Store the completed file outside the repository with mode0600.
# Reference only; replace every placeholder. Do not paste credential values into chat.
DATABASE_URL=postgres://keepsave:<url-encoded-password>@db:5432/keepsave?sslmode=verify-full&sslrootcert=/run/keepsave/db-ca.crt
JWT_SECRET=<fresh-random-signing-secret-at-least-32-bytes>
# Existing Vault Transit wrapping-key integration; keep the wrapped key recoverable.
KEEPSAVE_KEY_PROVIDER=vault
VAULT_ADDR=https://<private-vault-origin>
VAULT_TOKEN=<least-privilege-transit-token>
KEEPSAVE_VAULT_KEY_NAME=<transit-key-name>
KEEPSAVE_VAULT_CIPHERTEXT=<recoverable-transit-wrapped-master-key>
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
KEEPSAVE_PROMOTIONS_ENABLED=true
# Empty disables each social sign-in provider. Configure both values together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Explicit operator grants replace email allowlists. Must stay empty.
KEEPSAVE_PLATFORM_ADMIN_EMAILS=
