# docker-compose secrets template. Copy to `.env` (gitignored) and edit.
#   cp .env.example .env
#
# Every value here has a dev default baked into docker-compose.yml, so the
# stack runs without a .env. Set these to override the committed dev defaults —
# which, per ADR-0016, are treated as permanently leaked and must never be used
# for anything real.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=keepsave
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=keepsave

# --- Backend --------------------------------------------------------------
# Connection string the API uses. sslmode=disable is dev-only; KEEPSAVE_ENV
# production refuses it.
DATABASE_URL=postgres://keepsave:change_me_locally@db:5432/keepsave?sslmode=disable

# Root encryption key, base64-encoded 32 bytes. Generate a fresh one:
#   openssl rand -base64 32
MASTER_KEY=

# JWT signing secret.
JWT_SECRET=

# Allowed CORS origins for the embed widget. Use an explicit allowlist, not "*".
CORS_ORIGINS=http://localhost:3002

# Per-process connection budget (SQLite uses one connection regardless).
# For a small instance, try 4 open / 1 idle and measure your workload.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2

# Deprecated: email claims never grant platform privileges. Leave empty.
# Issue/revoke a user-ID grant with the private keepsave-operator command.
KEEPSAVE_PLATFORM_ADMIN_EMAILS=

# Optional GitHub / Google sign-in. See docs/SOCIAL_LOGIN_SETUP.md.
# Backend only: never use VITE_ for client secrets. Keep both values empty to disable.
SOCIAL_AUTH_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trusted worker only. Enable scheduling after a recorded isolated recovery drill.
KEEPSAVE_BACKUP_DIRECTORY=/var/lib/keepsave/backups
KEEPSAVE_RECOVERY_VERIFIED=false
