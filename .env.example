# docker-compose secrets template. Copy to `.env` (gitignored) and edit.
#   cp .env.example .env
#
# Every value here has a dev default baked into docker-compose.yml, so the
# stack runs without a .env. Set these to override the committed dev defaults —
# which, per ADR-0016, are treated as permanently leaked and must never be used
# for anything real.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=keepsave
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=keepsave

# --- Backend --------------------------------------------------------------
# Connection string the API uses. sslmode=disable is dev-only; KEEPSAVE_ENV
# production refuses it.
DATABASE_URL=postgres://keepsave:change_me_locally@db:5432/keepsave?sslmode=disable

# Root encryption key, base64-encoded 32 bytes. Generate a fresh one:
#   openssl rand -base64 32
MASTER_KEY=

# JWT signing secret.
JWT_SECRET=

# Allowed CORS origins for the embed widget. Use an explicit allowlist, not "*".
CORS_ORIGINS=http://localhost:3002
