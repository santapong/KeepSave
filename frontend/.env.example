# KeepSave frontend environment configuration.
#
# Copy to .env.local for local overrides (gitignored). Vite reads
# VITE_-prefixed vars at build time and inlines them into the bundle, so
# never put secrets here - only public configuration.

# Absolute backend origin, including the /api/v1 prefix. Leave empty for
# local development - Vite's dev proxy in vite.config.ts forwards /api/v1
# to localhost:8080. Set in Vercel project env for Preview and Production.
# VITE_API_BASE_URL=https://api-uat.keepsave.example/api/v1
